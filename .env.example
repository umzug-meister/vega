# Lokale Entwicklungswerte. In Produktion ausschließlich Runtime-Secrets verwenden.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173
BETTER_AUTH_SECRET=

# Lokale MariaDB aus docker-compose.yml; in Hostinger durch die dortige
# Datenbankverbindung ersetzen. Zugangsdaten in der URL prozentkodieren.
DATABASE_URL=mysql://vega:vega_local_dev@127.0.0.1:3307/vega

# Einmaliger Admin-Bootstrap für `npm run db:seed`; nach erfolgreichem Seed entfernen.
# root_user ist der Anzeigename; der Login erfolgt per E-Mail.
# Passwort: mindestens 8 Zeichen, mit Großbuchstabe, Kleinbuchstabe und Zahl.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Hostinger Mail API: ausschließlich als Server-Runtime-Secrets setzen.
# resourceId über GET https://api.mail.hostinger.com/api/v1/me ermitteln.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=
# Optionaler Override für Staging/Mocks; standardmäßig https://api.mail.hostinger.com.
HOSTINGER_MAIL_API_BASE_URL=

# Google-Zugang ausschließlich serverseitig; ohne Konfiguration kein Provideraufruf.
# Ein einziger Schlüssel für Places API (New) und Routes API.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# Postfach-Analyse (Vertex AI, global); siehe docs/gemini-setup.md. Leer = deaktiviert.
GEMINI_ENABLED=
GEMINI_LOCATION=
GEMINI_MODEL=
# Pfad zu extern verwalteten ADC-Credentials; keine Schlüsseldatei ins Repository legen.
