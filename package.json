{
  "name": "vega",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/server",
    "apps/admin",
    "apps/customer-form",
    "packages/domain"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,admin,form --prefix-colors cyan,magenta,green \"npm:dev:server\" \"npm:dev:admin\" \"npm:dev:form\"",
    "dev:server": "npm run dev --workspace @vega/server",
    "dev:admin": "npm run dev --workspace @vega/admin",
    "dev:form": "npm run dev --workspace @vega/customer-form",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:status": "docker compose ps db",
    "db:logs": "docker compose logs -f db",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check-schema": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:import-legacy-catalog": "tsx prisma/import-legacy-catalog.ts",
    "auth:generate-schema": "auth generate --config apps/server/src/auth.ts --adapter prisma --output prisma/schema.prisma",
    "auth:recover-admin": "tsx prisma/recover-admin.ts",
    "build": "npm run db:generate && npm run typecheck && npm run build:server && npm run build:frontends",
    "postbuild": "node scripts/postbuild.js",
    "build:domain": "npm run build --workspace @vega/domain",
    "build:server": "npm run build --workspace @vega/server",
    "build:frontends": "npm run build --workspace @vega/admin && npm run build --workspace @vega/customer-form",
    "typecheck": "npm run build --workspace @vega/domain && npm run typecheck --workspace @vega/server && npm run typecheck --workspace @vega/admin && npm run typecheck --workspace @vega/customer-form && tsc --noEmit -p prisma/tsconfig.json",
    "lint": "oxlint --deny correctness --allow no-unused-vars --allow no-control-regex apps packages prisma",
    "test": "tsx --import ./apps/server/test/setup.ts --test apps/server/test/*.test.ts apps/admin/test/*.test.ts apps/customer-form/test/*.test.ts",
    "test:database": "tsx --test --test-concurrency=1 apps/server/test/database/*.test.ts",
    "test:deployment": "tsx --test apps/server/test/deployment/*.test.ts",
    "cron": "node scripts/cron.js",
    "start": "node server.js"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "auth": "1.7.7",
    "concurrently": "10.0.6",
    "dotenv": "16.6.1",
    "jsdom": "30.1.3",
    "oxlint": "1.87.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "mysql2": "3.24.6",
    "shell-quote": "1.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
