generator client {
  provider               = "prisma-client"
  output                 = "../apps/server/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String      @id
  name               String
  email              String
  emailVerified      Boolean     @default(false)
  image              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  twoFactorEnabled   Boolean?    @default(false)
  role               String      @default("Kundenberater")
  mustChangePassword Boolean     @default(false)
  blocked            Boolean     @default(false)
  /// Name in the greeting block of staff mails, e.g. "Max Meier".
  signatureName      String?     @db.VarChar(100)
  /// Approved greeting signature color; black by default, optional Vega blue.
  signatureColor     String      @default("#000000") @db.VarChar(7)
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]

  @@unique([email])
  @@index([role, blocked])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  // Encrypted backup-code payload exceeds MySQL's default VARCHAR(191) limit.
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model Order {
  id            String               @id @default(cuid())
  revision      Int                  @default(0)
  orderNumber   Int                  @unique
  customerName  String               @db.VarChar(300)
  customerEmail String?              @db.VarChar(254)
  customerPhone String               @db.VarChar(64)
  source        String               @db.VarChar(32)
  data          Json
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  edited        Boolean              @default(false)
  archivedAt    DateTime?
  purgeAt       DateTime?
  originOrderId String?
  originOrder   Order?               @relation("OrderCopies", fields: [originOrderId], references: [id], onDelete: SetNull)
  copies        Order[]              @relation("OrderCopies")
  emailOutbox   EmailOutbox[]        @relation("EmailOutboxOrder")
  emailOptions  EmailOutbox[]        @relation("EmailOutboxOption")
  emailEvents   EmailEvent[]
  activities    OrderActivityEvent[]
  invoice       Invoice?
  images        OrderImage[]
  addresses     OrderAddress[]
  positions     OrderPosition[]

  @@index([customerName])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([archivedAt, purgeAt])
  @@index([originOrderId])
  @@map("order")
}

enum OrderAddressRole {
  FROM
  TO
  SECONDARY_FROM
  SECONDARY_TO
}

model OrderAddress {
  id         String           @id
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  role       OrderAddressRole
  street     String           @db.VarChar(160)
  postalCode String           @db.VarChar(16)
  city       String           @db.VarChar(100)
  details    Json

  @@unique([orderId, role])
  @@index([postalCode, city])
  @@map("orderAddress")
}

enum OrderPositionKind {
  FURNITURE
  SERVICE
  PACKAGING
}

model OrderPosition {
  id        String            @id
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      OrderPositionKind
  position  Int
  name      String            @db.VarChar(191)
  quantity  Float             @db.Double
  volume    Float?            @db.Double
  category  String?           @db.VarChar(191)
  catalogId Int?

  @@unique([orderId, kind, position])
  @@index([catalogId])
  @@map("orderPosition")
}

model OrderImage {
  id         String    @id
  tokenHash  String    @db.VarChar(64)
  objectKey  String    @db.VarChar(191)
  size       Int
  generation String?   @db.VarChar(64)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([objectKey])
  @@index([expiresAt])
  @@map("orderImage")
}

model Invoice {
  id                   String          @id
  revision             Int             @default(0)
  invoiceNumber        String          @unique @db.VarChar(64)
  orderId              String?         @unique
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumberSnapshot  Int?
  customerNameSnapshot String          @db.VarChar(300)
  company              String          @default("") @db.VarChar(191)
  customerStreet       String          @default("") @db.VarChar(191)
  customerPostalCity   String          @default("") @db.VarChar(191)
  invoiceDate          DateTime
  taxPercent           Decimal         @default(19) @db.Decimal(5, 2)
  text                 String          @db.Text
  entries              Json
  dueDates             Json
  archivedAt           DateTime?
  purgeAt              DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  creditNote           CreditNote?
  reminders            ReminderEvent[]

  @@index([orderNumberSnapshot])
  @@index([customerNameSnapshot])
  @@index([archivedAt, purgeAt])
  @@map("invoice")
}

model CreditNote {
  id                    String    @id
  creditNumber          String    @unique @db.VarChar(64)
  invoiceId             String?   @unique
  invoice               Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceNumberSnapshot String    @db.VarChar(64)
  orderNumberSnapshot   Int?
  customerNameSnapshot  String    @db.VarChar(300)
  company               String    @db.VarChar(191)
  customerStreet        String    @db.VarChar(191)
  customerPostalCity    String    @db.VarChar(191)
  creditDate            DateTime
  taxPercent            Decimal   @db.Decimal(5, 2)
  text                  String    @db.Text
  entries               Json
  archivedAt            DateTime?
  purgeAt               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([invoiceNumberSnapshot])
  @@index([orderNumberSnapshot])
  @@index([customerNameSnapshot])
  @@index([archivedAt, purgeAt])
  @@map("creditNote")
}

model ReminderEvent {
  id                    String        @id
  invoiceId             String?
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceNumberSnapshot String        @db.VarChar(64)
  orderNumberSnapshot   Int?
  customerNameSnapshot  String        @db.VarChar(300)
  level                 Int
  dueDate               DateTime
  outstandingAmount     Decimal       @db.Decimal(12, 2)
  fee                   Decimal       @db.Decimal(12, 2)
  text                  String        @db.Text
  actorName             String        @db.VarChar(191)
  sentAt                DateTime?
  archivedAt            DateTime?
  purgeAt               DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  emails                EmailOutbox[]

  @@index([invoiceId, level])
  @@index([invoiceNumberSnapshot])
  @@index([orderNumberSnapshot])
  @@index([customerNameSnapshot])
  @@index([archivedAt, purgeAt])
  @@map("reminderEvent")
}

model InvoiceNumberSequence {
  id        Int @id
  nextValue Int

  @@map("invoiceNumberSequence")
}

model AppSettings {
  id               Int      @id
  revision         Int      @default(0)
  boxCbm           Decimal? @db.Decimal(10, 4)
  kleiderboxCbm    Decimal? @db.Decimal(10, 4)
  origin           String?  @db.VarChar(300)
  dataPrivacyUrl   String?  @db.VarChar(2048)
  successUrl       String?  @db.VarChar(2048)
  boxCalculatorUrl String?  @db.VarChar(2048)
  companyEmail     String?  @db.VarChar(254)
  emailFromName    String?  @db.VarChar(191)
  emailFromAddress String?  @db.VarChar(254)
  updatedAt        DateTime @updatedAt

  @@map("appSettings")
}

model OrderActivityEvent {
  id        String   @id
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(32)
  actorName String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("orderActivityEvent")
}

model EmailOutbox {
  id              String         @id
  orderId         String?
  order           Order?         @relation("EmailOutboxOrder", fields: [orderId], references: [id], onDelete: Cascade)
  /// Second offer of a two-option mail; receives only a journal entry after SENT.
  optionOrderId   String?
  optionOrder     Order?         @relation("EmailOutboxOption", fields: [optionOrderId], references: [id], onDelete: SetNull)
  /// Payment reminder sent with this mail; gets `sentAt` once the mail is SENT.
  reminderEventId String?
  reminderEvent   ReminderEvent? @relation(fields: [reminderEventId], references: [id], onDelete: SetNull)
  kind            String         @db.VarChar(32)
  recipients      Json
  subject         String         @db.VarChar(998)
  contentHtml     String         @db.LongText
  attachments     Json?
  actorName       String?        @db.VarChar(191)
  /// Snapshot of the sender's signature name at queue time.
  signatureName   String?        @db.VarChar(100)
  /// Snapshot of the sender's approved signature color at queue time.
  signatureColor  String?        @db.VarChar(7)
  idempotencyKey  String         @unique @db.VarChar(191)
  status          String         @default("PENDING") @db.VarChar(16)
  attempts        Int            @default(0)
  nextAttemptAt   DateTime
  lockedAt        DateTime?
  sentAt          DateTime?
  lastErrorCode   String?        @db.VarChar(100)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          EmailEvent[]

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@index([optionOrderId])
  @@index([reminderEventId])
  @@map("emailOutbox")
}

model EmailEvent {
  id        String      @id
  outboxId  String
  outbox    EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String      @db.VarChar(32)
  actorName String?     @db.VarChar(191)
  sentAt    DateTime
  createdAt DateTime    @default(now())

  @@unique([outboxId])
  @@index([orderId])
  @@index([sentAt])
  @@map("emailEvent")
}

model PublicApiRateLimit {
  key             String   @id @db.VarChar(191)
  windowStartedAt DateTime
  count           Int      @default(0)

  @@index([windowStartedAt], map: "publicOrderRateLimit_windowStartedAt_idx")
  @@map("publicApiRateLimit")
}

model OrderNumberSequence {
  id        Int @id
  nextValue Int

  @@map("orderNumberSequence")
}

model CatalogCategory {
  id        Int                        @id @default(autoincrement())
  name      String                     @db.VarChar(191)
  sort      Int                        @default(0)
  furniture CatalogFurnitureCategory[]

  @@index([sort])
  @@map("catalogCategory")
}

model CatalogFurniture {
  id         Int                        @id @default(autoincrement())
  name       String                     @db.VarChar(191)
  volume     Decimal                    @default(0) @db.Decimal(10, 2)
  step       Decimal                    @default(1) @db.Decimal(7, 1)
  sortOrder  Int                        @default(0)
  categories CatalogFurnitureCategory[]

  @@index([sortOrder])
  @@map("catalogFurniture")
}

model CatalogFurnitureCategory {
  furnitureId Int
  categoryId  Int
  furniture   CatalogFurniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  category    CatalogCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([furnitureId, categoryId])
  @@index([categoryId])
  @@map("catalogFurnitureCategory")
}

model CatalogService {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(191)
  price Decimal @default(0) @db.Decimal(10, 2)
  sort  Int     @default(0)
  show  Boolean @default(true)

  @@index([sort])
  @@map("catalogService")
}

model CatalogPacking {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(191)
  price       Decimal @default(0) @db.Decimal(10, 2)
  description String  @db.Text
  media       String? @db.VarChar(2048)
  sort        Int     @default(0)
  show        Boolean @default(true)

  @@index([sort])
  @@map("catalogPacking")
}

model CatalogOffer {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(191)
  workers       Int
  trucks        Int
  includedHours Int
  sum           Decimal @default(0) @db.Decimal(10, 2)
  hourPrice     Decimal @default(0) @db.Decimal(10, 2)
  ridingCosts   Decimal @default(0) @db.Decimal(10, 2)
  sort          Int     @default(0)

  @@unique([trucks, workers, includedHours])
  @@index([sort])
  @@map("catalogOffer")
}

model CatalogServiceRate {
  key   String  @id @db.VarChar(64)
  price Decimal @default(0) @db.Decimal(10, 2)

  @@map("catalogServiceRate")
}
